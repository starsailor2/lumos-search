{
  "name": "lumos-search",
  "productName": "Lumos Search",
  "version": "2.0.5",
  "description": "Premium Raycast-class global search for Windows.",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:smoke": "npm run build && electron tests/electron-smoke.cjs",
    "test:benchmark": "node tests/search-benchmark.cjs",
    "dist": "vite build && electron-builder --win"
  },
  "author": "Starsailor",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.starsailor.lumos",
    "productName": "Lumos Search",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/icon.ico",
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "src/**/*",
      "dist/renderer/**/*",
      "public/**/*",
      "extensions/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "starsailor2",
      "repo": "lumos-search"
    }
  }
}
