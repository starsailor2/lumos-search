{
  "name": "lumos-search",
  "productName": "Lumos Search",
  "version": "2.0.0",
  "description": "Premium Raycast-class global search for Windows.",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite build --watch",
    "build": "vite build",
    "dist": "vite build && electron-builder --win"
  },
  "author": "Starsailor",
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.2",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.3.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.starsailor.lumos",
    "productName": "Lumos Search",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/icon.ico",
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true
    },
    "files": [
      "src/**/*",
      "dist/renderer/**/*",
      "public/**/*",
      "extensions/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "starsailor",
      "repo": "lumos-search"
    }
  }
}
